DONE_CONF=conf/done.conf
EMMC_TARGET=/dev/mmcblk2

declare -A tarch_arr=(['cl-som-imx7']="armhf")
tarch=${tarch_arr[cl-som-imx7]:-"arm64"}


function armhf_uuid_templates() {

UUID=$(uuidgen --md5 --time | awk -F"-" '$0=$1')

cat << eof
# Enable UUID
MENDER_FEATURES_ENABLE:append = " mender-partuuid "

MENDER_BOOT_PART = "${UUID}-01"
MENDER_DATA_PART = "${UUID}-04"
MENDER_ROOTFS_PART_A = "${UUID}-02"
MENDER_ROOTFS_PART_B = "${UUID}-03"

#
MENDER_UBOOT_STORAGE_INTERFACE = "spi"
MENDER_UBOOT_STORAGE_DEVICE = "0"
MENDER_UBOOT_MMC_ENV_LINUX_DEVICE_PATH = "/dev/mtd1"
MENDER_STORAGE_DEVICE = ""
eof

}


function armhf_templates() {
	T="../sources/meta-mender-compulab/templates/armhf"
	for _d in ${T}/*;do
		_file=$(basename ${_d})
		for _f in ${_d}/*;do
			[[ -f ${_f} ]] || continue
			cat ${_f} >> conf/${_file}
		done;
	done
	armhf_uuid_templates >> conf/local.conf
}

function arm64_templates() {

	# 1 Update the bblayers.conf
	cat ../sources/meta-mender-compulab/templates/arm64/bblayers-mender.conf.append >> conf/bblayers.conf

	# 2 Update the local.conf
	## 2.1 Comunity
	# cat ../sources/meta-mender-community/templates/local.conf.append >> conf/local.conf
	## 2.2 Compulab
	cat ../sources/meta-mender-compulab/templates/arm64/local-extra.conf.append >> conf/local.conf
	cat ../sources/meta-mender-compulab/templates/arm64/local-read-only-rootfs.conf.append >> conf/local.conf

	# generate an unique uuid for earch setup
	image_sign=$(uuidgen --md5 --namespace @dns --name ${EMMC_TARGET} | awk -F"-" '$0=$1')
	sed "s|##UUID##|${image_sign}|g" ../sources/meta-mender-compulab/templates/arm64/local.conf.append >> conf/local.conf
}

function noarch_templates() {
	## 2.1 Comunity
	cat ../sources/meta-mender-community/templates/local.conf.append >> conf/local.conf
}

if [[ -e ${DONE_CONF} ]];then
cat << eof
Already configured
eof
else
	noarch_templates
	${tarch}_templates
	touch ${DONE_CONF}
fi
