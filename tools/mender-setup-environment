#!/bin/bash -e

SETUP=${SETUP:-"compulab-setup-env"}

D=$(dirname $(readlink -f ${BASH_SOURCE[0]}))

O=${D}/../overlays

# A temporarily fix for passing a "-b" key to the next script

grep -w -- "-b" ${SETUP} && PARAM=$@ || PARAM="-b $@"

source ${SETUP} $PARAM

cp -a ${O}/* ${BUILDDIR}/../sources/

source ${D}/setup-conf

# mender provides its own grub/efi configuration
bitbake-layers remove-layer meta-compulab-uefi
