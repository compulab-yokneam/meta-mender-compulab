From: Valentin Raevsky <valentin@compulab.co.il>
Date: Sun, 17 May 2020 21:44:07 +0300
Subject: [PATCH 2/2] cl-som-imx7: Add support to mender

Signed-off-by: Valentin Raevsky <valentin@compulab.co.il>

%% original patch: 0002-cl-som-imx7-Add-support-to-mender.patch

Signed-off-by: Valentin Raevsky <valentin@compulab.co.il>
---
 configs/cl-som-imx7_defconfig | 2 ++
 include/configs/cl-som-imx7.h | 4 +++-
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/configs/cl-som-imx7_defconfig b/configs/cl-som-imx7_defconfig
index d1f1aa4b68..0b1604018e 100644
--- a/configs/cl-som-imx7_defconfig
+++ b/configs/cl-som-imx7_defconfig
@@ -51,6 +51,8 @@ CONFIG_CMD_FAT=y
 CONFIG_CMD_FS_GENERIC=y
 # CONFIG_ENV_IS_IN_MMC is not set
 CONFIG_ENV_IS_IN_SPI_FLASH=y
+CONFIG_BOOTCOUNT_LIMIT=y
+CONFIG_BOOTCOUNT_ENV=y
 CONFIG_LED_STATUS=y
 CONFIG_LED_STATUS_GPIO=y
 CONFIG_LED_STATUS0=y
diff --git a/include/configs/cl-som-imx7.h b/include/configs/cl-som-imx7.h
index 06bf33fb62..cb9fe56c1d 100644
--- a/include/configs/cl-som-imx7.h
+++ b/include/configs/cl-som-imx7.h
@@ -179,7 +179,7 @@
 
 /* FLASH and environment organization */
 #define CONFIG_ENV_SIZE			SZ_8K
-#define CONFIG_ENV_OFFSET		(768 * 1024)
+#define CONFIG_ENV_OFFSET              (768 * 1024)
 #define CONFIG_ENV_SECT_SIZE		(64 * 1024)
 #define CONFIG_ENV_SPI_BUS		CONFIG_SF_DEFAULT_BUS
 #define CONFIG_ENV_SPI_CS		CONFIG_SF_DEFAULT_CS
@@ -241,4 +241,6 @@
 #define CONFIG_ENV_CALLBACK_LIST_STATIC "displaytype:displaytype"
 #endif /* CONFIG_VIDEO */
 
+#define CONFIG_SYS_REDUNDAND_ENVIRONMENT
+
 #endif	/* __CONFIG_H */
