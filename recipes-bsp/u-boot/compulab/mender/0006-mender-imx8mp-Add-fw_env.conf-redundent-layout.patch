From e47ced0752d2065552bda4a540db47486aa6df61 Mon Sep 17 00:00:00 2001
From: Valentin Raevsky <valentin@compulab.co.il>
Date: Fri, 4 Jul 2025 11:30:31 +0300
Subject: [PATCH] mender: imx8mp: Add fw_env.conf redundent layout

Signed-off-by: Valentin Raevsky <valentin@compulab.co.il>
---
 tools/env/fw_env.config | 8 +++-----
 1 file changed, 3 insertions(+), 5 deletions(-)

diff --git a/tools/env/fw_env.config b/tools/env/fw_env.config
index 02ba2da1aa..35eda5b689 100644
--- a/tools/env/fw_env.config
+++ b/tools/env/fw_env.config
@@ -7,8 +7,6 @@
 # Device offset must be prefixed with 0x to be parsed as a hexadecimal value.
 
 # Block devices for CompuLab imx8m-plus
-# emmc
-/dev/mmcblk2boot0	0x3f0000 0x4000
-#/dev/mmcblk2boot1	0x3f0000 0x4000
-# sd-card; if AltBoot is in use
-#/dev/mmcblk1		0x3f0000 0x4000
+# emmc redundent layout
+/dev/mmcblk2boot0	0x380000 0x20000
+/dev/mmcblk2boot0	0x3B0000 0x20000
-- 
2.34.1

